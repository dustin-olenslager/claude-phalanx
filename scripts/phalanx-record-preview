#!/usr/bin/env node
"use strict";
// phalanx-record-preview — P1: records before/after Playwright clips for a
// committed .phalanx/previews/<slug>.mjs journey. Soft gate: never blocks, never
// touches the verify flag, always exits 0. See docs/adr/ADR-0005.
const fs = require("fs");
const path = require("path");
const cp = require("child_process");
const crypto = require("crypto");
const { pathToFileURL } = require("url");

const DEFAULT_CONFIG = {
  baseUrl: "http://127.0.0.1:3000",
  startCmd: null,
  readyTimeoutMs: 120000,
  viewports: [390, 1440],
  budgetBytes: 10485760,
  userFacingPaths: ["src/**", "app/**", "components/**", "pages/**", "public/**", "styles/**"],
};

function loadHookLib() {
  for (const rel of ["../hooks/gates/lib/phalanx-hook.js", "../lib/phalanx-hook.js"]) {
    try { return require(path.join(__dirname, rel)); } catch {}
  }
  return null;
}

function parseArgs(argv) {
  const opts = { slug: null, journey: null, json: false, dryRun: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--slug") opts.slug = argv[++i];
    else if (a === "--journey") opts.journey = argv[++i];
    else if (a === "--json") opts.json = true;
    else if (a === "--dry-run") opts.dryRun = true;
  }
  return opts;
}

function ensureGitignore(root) {
  try {
    const dir = path.join(root, ".claude-runs");
    const gi = path.join(dir, ".gitignore");
    if (!fs.existsSync(gi)) {
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(gi, "*\n");
    }
  } catch {}
}

function parseConfig(markerPath) {
  const raw = fs.readFileSync(markerPath, "utf8").trim();
  if (!raw) return { ...DEFAULT_CONFIG };
  const parsed = JSON.parse(raw);
  return { ...DEFAULT_CONFIG, ...parsed };
}

function resolveJourneyFiles(root, previewsDir, opts) {
  if (opts.journey) {
    const p = path.isAbsolute(opts.journey) ? opts.journey : path.join(root, opts.journey);
    return fs.existsSync(p) ? [p] : [];
  }
  if (opts.slug) {
    const p = path.join(previewsDir, opts.slug + ".mjs");
    return fs.existsSync(p) ? [p] : [];
  }
  try {
    return fs.readdirSync(previewsDir).filter((f) => f.endsWith(".mjs")).sort()
      .map((f) => path.join(previewsDir, f));
  } catch { return []; }
}

function getMergeBase(root) {
  try {
    return cp.execFileSync("git", ["merge-base", "origin/main", "HEAD"], {
      cwd: root, stdio: ["ignore", "pipe", "ignore"],
    }).toString().trim() || null;
  } catch { return null; }
}

function hashFile(file) {
  return crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex").slice(0, 12);
}

function clearDir(dir) {
  try { fs.rmSync(dir, { recursive: true, force: true }); } catch {}
}

async function loadJourney(file) {
  try { return { mod: await import(pathToFileURL(file).href), error: null }; }
  catch (e) { return { mod: null, error: String((e && e.message) || e) }; }
}

async function buildDryRunPlan(root, journeyFiles, config, mergeBase) {
  const baselineDir = path.join(root, ".claude-runs", "previews", "baseline");
  const journeys = [];
  for (const file of journeyFiles) {
    const slug = path.basename(file, ".mjs");
    const journeyHash = hashFile(file);
    const { mod, error } = await loadJourney(file);
    const sinceMain = !!(mod && mod.sinceMain);
    const viewports = (mod && mod.viewports) || config.viewports;
    const perViewport = viewports.map((vw) => {
      let baselinePath = null, baselineCached = false, willRecordBefore = false;
      if (!sinceMain && mergeBase) {
        baselinePath = path.join(baselineDir, `${mergeBase}.${journeyHash}.${vw}.webm`);
        baselineCached = fs.existsSync(baselinePath);
        willRecordBefore = !baselineCached;
      }
      return { viewport: vw, baselinePath, baselineCached, willRecordBefore };
    });
    journeys.push({
      slug, title: (mod && mod.title) || slug, sinceMain, viewports,
      journeyHash, mergeBase, loadError: error, perViewport,
    });
  }
  return { dryRun: true, mergeBase, journeys };
}

function resolvePlaywright(root) {
  for (const pkg of ["playwright", "playwright-core"]) {
    try { return require(require.resolve(pkg, { paths: [root, process.cwd(), __dirname] })); }
    catch {}
  }
  throw new Error("playwright not installed");
}

function waitReady(baseUrl, timeoutMs) {
  const mod = baseUrl.startsWith("https") ? require("https") : require("http");
  const deadline = Date.now() + timeoutMs;
  return new Promise((resolve, reject) => {
    const attempt = () => {
      const req = mod.request(baseUrl, { method: "HEAD", timeout: 3000 }, (res) => {
        res.resume();
        if (res.statusCode >= 200 && res.statusCode < 500) return resolve();
        retry();
      });
      req.on("error", retry);
      req.on("timeout", () => { req.destroy(); retry(); });
      req.end();
    };
    const retry = () => {
      if (Date.now() > deadline) return reject(new Error(`app did not become ready within ${timeoutMs}ms`));
      setTimeout(attempt, 500);
    };
    attempt();
  });
}

async function bootApp(startCmd, cwd, baseUrl, readyTimeoutMs) {
  if (!startCmd) return () => {};
  const proc = cp.spawn(startCmd, { cwd, shell: true, detached: true, stdio: "ignore" });
  try { await waitReady(baseUrl, readyTimeoutMs); }
  catch (e) { try { process.kill(-proc.pid); } catch {} throw e; }
  return () => { try { process.kill(-proc.pid); } catch {} };
}

function withTimeout(promise, ms) {
  let timer;
  const timeout = new Promise((_, reject) => {
    timer = setTimeout(() => reject(new Error(`journey timed out after ${ms}ms`)), ms);
  });
  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
}

// Records one clip: launches a context with video capture, runs the journey under
// budgetMs, and closes the context regardless of outcome so the video always
// flushes. Shared by the after-run and the before cache-miss recording.
async function recordClip(browser, previewsRoot, runFn, vw, vh, ctx, budgetMs) {
  const tmpDir = fs.mkdtempSync(path.join(previewsRoot, "tmp-"));
  try {
    const context = await browser.newContext({
      viewport: { width: vw, height: vh },
      recordVideo: { dir: tmpDir, size: { width: vw, height: vh } },
    });
    const page = await context.newPage();
    const video = page.video();
    let runErr = null;
    try { await withTimeout(runFn(page, ctx), budgetMs); }
    catch (e) { runErr = e; }
    // context.close() finalizes the video file; video.path() only resolves to a
    // real path once that happens (must record even when the journey timed out).
    await context.close();
    if (runErr) return { error: String((runErr && runErr.message) || runErr), recordedPath: null };
    return { error: null, recordedPath: await video.path() };
  } finally {
    fs.rmSync(tmpDir, { recursive: true, force: true });
  }
}

async function recordAfter(browser, previewsRoot, mod, slug, vw, vh, config, outDir, budgetMs) {
  const ctx = { baseUrl: config.baseUrl, viewport: vw, side: "after", slug, outDir };
  const { error, recordedPath } = await recordClip(browser, previewsRoot, mod.run, vw, vh, ctx, budgetMs);
  if (error) return { path: null, error };
  const destPath = path.join(outDir, `${slug}.${vw}.after.webm`);
  try { fs.renameSync(recordedPath, destPath); }
  catch (e) { return { path: null, error: `failed to save clip: ${e.message}` }; }
  return { path: destPath, error: null };
}

async function recordBefore(browser, root, previewsRoot, mod, slug, journeyHash, mergeBase, vw, vh, config, outDir, budgetMs) {
  if (mod.sinceMain) {
    try {
      fs.writeFileSync(
        path.join(outDir, `${slug}.${vw}.before-missing.txt`),
        "This screen did not exist on main — no before recording.\n",
      );
    } catch {}
    return { path: null, cached: false, missing: true, missingReason: "sinceMain" };
  }
  if (!mergeBase) return { path: null, cached: false, missing: true, missingReason: "no merge-base" };

  const baselineDir = path.join(previewsRoot, "baseline");
  fs.mkdirSync(baselineDir, { recursive: true });
  const baselinePath = path.join(baselineDir, `${mergeBase}.${journeyHash}.${vw}.webm`);
  if (fs.existsSync(baselinePath)) return { path: baselinePath, cached: true, missing: false };

  const wtDir = path.join(previewsRoot, `wt-${mergeBase}`);
  try {
    cp.execFileSync("git", ["worktree", "add", "--detach", wtDir, mergeBase], { cwd: root, stdio: "ignore" });
  } catch (e) {
    return { path: null, cached: false, missing: true, missingReason: `worktree add failed: ${e.message}` };
  }
  let teardown = () => {};
  try {
    teardown = await bootApp(config.startCmd, wtDir, config.baseUrl, config.readyTimeoutMs);
    // Always the journey file loaded from HEAD, never a worktree copy — the same
    // code drives both checkouts so the two clips differ only by app behavior.
    const ctx = { baseUrl: config.baseUrl, viewport: vw, side: "before", slug, outDir };
    const { error, recordedPath } = await recordClip(browser, previewsRoot, mod.run, vw, vh, ctx, budgetMs);
    if (error) return { path: null, cached: false, missing: true, missingReason: `before-run failed: ${error}` };
    fs.renameSync(recordedPath, baselinePath);
    return { path: baselinePath, cached: false, missing: false };
  } catch (e) {
    return { path: null, cached: false, missing: true, missingReason: `before-run failed: ${e.message}` };
  } finally {
    teardown();
    try { cp.execFileSync("git", ["worktree", "remove", "--force", wtDir], { cwd: root, stdio: "ignore" }); } catch {}
  }
}

async function runAll(root, journeyFiles, config, mergeBase, pw) {
  const previewsRoot = path.join(root, ".claude-runs", "previews");
  fs.mkdirSync(previewsRoot, { recursive: true });
  const browser = await pw.chromium.launch();
  let teardownApp = () => {};
  const journeys = [];
  const lines = [];
  try {
    if (config.startCmd) {
      try { teardownApp = await bootApp(config.startCmd, root, config.baseUrl, config.readyTimeoutMs); }
      catch (e) { lines.push(`preview: app failed to become ready: ${e.message}`); }
    }
    for (const file of journeyFiles) {
      const slug = path.basename(file, ".mjs");
      const outDir = path.join(previewsRoot, slug);
      clearDir(outDir);
      fs.mkdirSync(outDir, { recursive: true });

      const journeyHash = hashFile(file);
      const { mod, error: loadError } = await loadJourney(file);
      if (loadError || !mod || typeof mod.run !== "function") {
        const reason = loadError || "journey does not export run(page, ctx)";
        lines.push(`${slug}: SKIPPED (${reason})`);
        journeys.push({
          slug, title: (mod && mod.title) || slug, sinceMain: !!(mod && mod.sinceMain),
          journeyHash, mergeBase, ok: false, error: reason,
          budgetBytes: config.budgetBytes, userFacingPaths: config.userFacingPaths, viewports: [],
        });
        continue;
      }

      const title = mod.title || slug;
      const sinceMain = !!mod.sinceMain;
      const viewports = mod.viewports || config.viewports;
      const budgetMs = mod.budgetMs || 60000;
      const viewportResults = [];
      let journeyOk = true;

      for (const vw of viewports) {
        const vh = vw === 390 ? 844 : 900;
        const before = await recordBefore(browser, root, previewsRoot, mod, slug, journeyHash, mergeBase, vw, vh, config, outDir, budgetMs);
        const after = await recordAfter(browser, previewsRoot, mod, slug, vw, vh, config, outDir, budgetMs);
        if (after.error) journeyOk = false;
        viewportResults.push({
          viewport: vw,
          before: { path: before.path, cached: before.cached, missing: before.missing, missingReason: before.missingReason || null },
          after: { path: after.path },
          error: after.error || null,
        });
        const beforeState = before.missing ? `missing(${before.missingReason})` : before.cached ? "cached" : "recorded";
        lines.push(`${slug} @${vw}: before=${beforeState} after=${after.error ? `FAILED (${after.error})` : "recorded"}`);
      }

      // --- P2: composite + attach hook point ---
      journeys.push({
        slug, title, sinceMain, journeyHash, mergeBase, ok: journeyOk, error: null,
        budgetBytes: config.budgetBytes, userFacingPaths: config.userFacingPaths, viewports: viewportResults,
      });
    }
  } finally {
    teardownApp();
    try { await browser.close(); } catch {}
  }
  return { generatedAt: new Date().toISOString(), journeys, lines };
}

function writeResult(root, result) {
  const { lines, ...persisted } = result;
  try {
    fs.writeFileSync(path.join(root, ".claude-runs", "previews", "result.json"), JSON.stringify(persisted, null, 2));
  } catch (e) { console.error(`preview: failed to write result.json: ${e.message}`); }
}

function pruneOldBaselines(root) {
  const dir = path.join(root, ".claude-runs", "previews", "baseline");
  let files;
  try { files = fs.readdirSync(dir); } catch { return; }
  const cutoff = Date.now() - 7 * 24 * 60 * 60 * 1000;
  for (const f of files) {
    const p = path.join(dir, f);
    try { if (fs.statSync(p).mtimeMs < cutoff) fs.unlinkSync(p); } catch {}
  }
}

function finalTally(result) {
  let recorded = 0, skipped = 0, failed = 0;
  for (const j of result.journeys) {
    if (j.viewports.length === 0) { skipped++; continue; }
    for (const v of j.viewports) (v.error ? failed++ : recorded++);
  }
  return `preview: ${recorded} recorded, ${skipped} skipped, ${failed} failed`;
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const H = loadHookLib();
  if (!H) { console.log("preview: skipped (phalanx-hook.js not found)"); return; }
  const root = H.repoRoot(process.cwd());
  ensureGitignore(root);

  const markerPath = path.join(root, ".phalanx-preview");
  if (!fs.existsSync(markerPath)) { console.log("preview: skipped (no .phalanx-preview marker)"); return; }

  let config;
  try { config = parseConfig(markerPath); }
  catch (e) { console.log(`preview: skipped (invalid .phalanx-preview: ${e.message})`); return; }

  const previewsDir = path.join(root, ".phalanx", "previews");
  const journeyFiles = resolveJourneyFiles(root, previewsDir, opts);
  if (journeyFiles.length === 0) { console.log("preview: skipped (no journeys)"); return; }

  const mergeBase = getMergeBase(root);

  if (opts.dryRun) {
    console.log(JSON.stringify(await buildDryRunPlan(root, journeyFiles, config, mergeBase), null, 2));
    return;
  }

  let pw;
  try { pw = resolvePlaywright(root); }
  catch { console.log("preview: skipped (playwright not installed)"); return; }

  const result = await runAll(root, journeyFiles, config, mergeBase, pw);
  writeResult(root, result);
  pruneOldBaselines(root);

  if (opts.json) console.log(JSON.stringify({ generatedAt: result.generatedAt, journeys: result.journeys }));
  else { for (const line of result.lines) console.log(line); console.log(finalTally(result)); }
}

function safeExit(e) {
  try { console.error(`preview: unexpected error: ${(e && e.stack) || e}`); } catch {}
  process.exit(0);
}
process.on("unhandledRejection", safeExit);
process.on("uncaughtException", safeExit);

(async () => {
  try { await main(); }
  catch (e) { safeExit(e); return; }
  process.exit(0);
})();
