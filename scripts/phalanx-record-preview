#!/usr/bin/env node
"use strict";
// phalanx-record-preview — P1: records before/after Playwright clips for a
// committed .phalanx/previews/<slug>.mjs journey. Soft gate: never blocks, never
// touches the verify flag, always exits 0. See docs/adr/ADR-0005.
const fs = require("fs");
const os = require("os");
const path = require("path");
const cp = require("child_process");
const crypto = require("crypto");
const { pathToFileURL } = require("url");

const DEFAULT_CONFIG = {
  baseUrl: "http://127.0.0.1:3000",
  startCmd: null,
  readyTimeoutMs: 120000,
  viewports: [390, 1440],
  budgetBytes: 10485760,
  userFacingPaths: ["src/**", "app/**", "components/**", "pages/**", "public/**", "styles/**"],
  storageState: null,
};

function loadHookLib() {
  for (const rel of ["../hooks/gates/lib/phalanx-hook.js", "../lib/phalanx-hook.js"]) {
    try { return require(path.join(__dirname, rel)); } catch {}
  }
  return null;
}

function parseArgs(argv) {
  const opts = { slug: null, journey: null, json: false, dryRun: false, attach: null, pr: null, force: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--slug") opts.slug = argv[++i];
    else if (a === "--journey") opts.journey = argv[++i];
    else if (a === "--json") opts.json = true;
    else if (a === "--dry-run") opts.dryRun = true;
    else if (a === "--attach") opts.attach = true;
    else if (a === "--no-attach") opts.attach = false;
    else if (a === "--pr") opts.pr = argv[++i];
    else if (a === "--force") opts.force = true;
  }
  return opts;
}

function ensureGitignore(root) {
  try {
    const dir = path.join(root, ".claude-runs");
    const gi = path.join(dir, ".gitignore");
    if (!fs.existsSync(gi)) {
      fs.mkdirSync(dir, { recursive: true });
      fs.writeFileSync(gi, "*\n");
    }
  } catch {}
}

function parseConfig(markerPath) {
  const raw = fs.readFileSync(markerPath, "utf8").trim();
  if (!raw) return { ...DEFAULT_CONFIG };
  const parsed = JSON.parse(raw);
  return { ...DEFAULT_CONFIG, ...parsed };
}

// --- diff gate: skip recording unless the branch touches a user-facing path ---------
// Translates a `**`/`*`/`?` glob to a RegExp — no dependency, no minimatch.
function globToRegExp(pattern) {
  let re = "";
  for (let i = 0; i < pattern.length; i++) {
    const c = pattern[i];
    if (c === "*" && pattern[i + 1] === "*") {
      re += ".*";
      i++;
      if (pattern[i + 1] === "/") i++;
    } else if (c === "*") re += "[^/]*";
    else if (c === "?") re += "[^/]";
    else if ("\\^$.|+()[]{}".includes(c)) re += "\\" + c;
    else re += c;
  }
  return new RegExp("^" + re + "$");
}

function globMatch(pattern, filePath) {
  return globToRegExp(pattern).test(filePath);
}

function getDiffPaths(root, mergeBase) {
  const args = mergeBase ? ["diff", "--name-only", `${mergeBase}...HEAD`] : ["diff", "--name-only", "HEAD"];
  try {
    return cp.execFileSync("git", args, { cwd: root, stdio: ["ignore", "pipe", "ignore"] })
      .toString().split("\n").map((s) => s.trim()).filter(Boolean);
  } catch { return []; }
}

// gated = true means no diffed path matched a userFacingPaths glob, so recording
// would be wasted work — the caller decides whether --force overrides that.
function computeUserFacing(root, mergeBase, patterns) {
  const diffed = getDiffPaths(root, mergeBase);
  const changed = diffed.filter((f) => patterns.some((pat) => globMatch(pat, f)));
  return { changed, gated: changed.length === 0 };
}

// storageState lets a journey start already signed in (e.g. Google SSO, which the
// recorder must never drive by hand). Resolved relative to the repo root; missing
// or unreadable is a warning, never a failure — the clip just records signed-out.
function resolveStorageState(root, config) {
  if (!config.storageState) return null;
  const resolved = path.isAbsolute(config.storageState) ? config.storageState : path.join(root, config.storageState);
  let exists = false;
  try { fs.accessSync(resolved, fs.constants.R_OK); exists = true; } catch {}
  return { path: resolved, exists };
}

function resolveJourneyFiles(root, previewsDir, opts) {
  if (opts.journey) {
    const p = path.isAbsolute(opts.journey) ? opts.journey : path.join(root, opts.journey);
    return fs.existsSync(p) ? [p] : [];
  }
  if (opts.slug) {
    const p = path.join(previewsDir, opts.slug + ".mjs");
    return fs.existsSync(p) ? [p] : [];
  }
  try {
    return fs.readdirSync(previewsDir).filter((f) => f.endsWith(".mjs")).sort()
      .map((f) => path.join(previewsDir, f));
  } catch { return []; }
}

function getMergeBase(root) {
  try {
    return cp.execFileSync("git", ["merge-base", "origin/main", "HEAD"], {
      cwd: root, stdio: ["ignore", "pipe", "ignore"],
    }).toString().trim() || null;
  } catch { return null; }
}

function hashFile(file) {
  return crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex").slice(0, 12);
}

function clearDir(dir) {
  try { fs.rmSync(dir, { recursive: true, force: true }); } catch {}
}

async function loadJourney(file) {
  try { return { mod: await import(pathToFileURL(file).href), error: null }; }
  catch (e) { return { mod: null, error: String((e && e.message) || e) }; }
}

async function buildDryRunPlan(root, journeyFiles, config, mergeBase) {
  const baselineDir = path.join(root, ".claude-runs", "previews", "baseline");
  const journeys = [];
  for (const file of journeyFiles) {
    const slug = path.basename(file, ".mjs");
    const journeyHash = hashFile(file);
    const { mod, error } = await loadJourney(file);
    const sinceMain = !!(mod && mod.sinceMain);
    const viewports = (mod && mod.viewports) || config.viewports;
    const perViewport = viewports.map((vw) => {
      let baselinePath = null, baselineCached = false, willRecordBefore = false;
      if (!sinceMain && mergeBase) {
        baselinePath = path.join(baselineDir, `${mergeBase}.${journeyHash}.${vw}.webm`);
        baselineCached = fs.existsSync(baselinePath);
        willRecordBefore = !baselineCached;
      }
      return { viewport: vw, baselinePath, baselineCached, willRecordBefore };
    });
    journeys.push({
      slug, title: (mod && mod.title) || slug, sinceMain, viewports,
      journeyHash, mergeBase, loadError: error, perViewport,
    });
  }
  return { dryRun: true, mergeBase, ffmpeg: findFfmpeg(), ghVersion: ghVersion(), journeys };
}

// --- ffmpeg tier detection ---------------------------------------------------
// Playwright's bundled ffmpeg is built --disable-everything: only pad/crop/scale,
// libvpx_vp8, and the WebM muxer. No hstack, no drawtext. Presence on disk does
// NOT imply capability — the -filters listing is probed, never assumed.
let ffmpegCache;

function playwrightFfmpegCandidates() {
  const base = process.env.PLAYWRIGHT_BROWSERS_PATH || path.join(os.homedir(), ".cache", "ms-playwright");
  let entries;
  try { entries = fs.readdirSync(base); } catch { return []; }
  const versioned = entries
    .map((e) => ({ e, m: e.match(/^ffmpeg-(\d+)$/) }))
    .filter((x) => x.m)
    .sort((a, b) => Number(b.m[1]) - Number(a.m[1]));
  const bins = ["ffmpeg-linux", "ffmpeg-mac", "ffmpeg-win.exe"];
  const found = [];
  for (const { e } of versioned) {
    for (const bin of bins) {
      const p = path.join(base, e, bin);
      if (fs.existsSync(p)) found.push(p);
    }
  }
  return found;
}

function probeFfmpegTier(candidate) {
  try {
    const res = cp.spawnSync(candidate, ["-hide_banner", "-filters"], { encoding: "utf8", timeout: 5000 });
    if (res.error) return null;
    const out = `${res.stdout || ""}${res.stderr || ""}`;
    if (!out) return null;
    return /^\s*\S*\s+hstack\b/m.test(out) ? "full" : "minimal";
  } catch { return null; }
}

function findFfmpeg() {
  if (ffmpegCache !== undefined) return ffmpegCache;
  if (process.env.PHALANX_FFMPEG) {
    const tier = probeFfmpegTier(process.env.PHALANX_FFMPEG);
    ffmpegCache = tier ? { path: process.env.PHALANX_FFMPEG, tier } : null;
    return ffmpegCache;
  }
  for (const candidate of ["ffmpeg", ...playwrightFfmpegCandidates()]) {
    const tier = probeFfmpegTier(candidate);
    if (tier) { ffmpegCache = { path: candidate, tier }; return ffmpegCache; }
  }
  ffmpegCache = null;
  return null;
}

// --- gh preflight + semver -----------------------------------------------
function ghVersion() {
  try {
    const out = cp.execFileSync("gh", ["--version"], { stdio: ["ignore", "pipe", "ignore"] }).toString();
    const m = out.match(/gh version (\d+\.\d+\.\d+)/);
    return m ? m[1] : null;
  } catch { return null; }
}

function semverGte(version, min) {
  const a = version.split(".").map(Number);
  const b = min.split(".").map(Number);
  for (let i = 0; i < 3; i++) {
    if ((a[i] || 0) !== (b[i] || 0)) return (a[i] || 0) > (b[i] || 0);
  }
  return true;
}

function ghAuthed() {
  try { cp.execFileSync("gh", ["auth", "status"], { stdio: "ignore" }); return true; }
  catch { return false; }
}

function resolvePr(root, forcedPr) {
  if (forcedPr) return String(forcedPr);
  try {
    return cp.execFileSync("gh", ["pr", "view", "--json", "number", "-q", ".number"], {
      cwd: root, stdio: ["ignore", "pipe", "ignore"],
    }).toString().trim() || null;
  } catch { return null; }
}

function resolvePlaywright(root) {
  for (const pkg of ["playwright", "playwright-core"]) {
    try { return require(require.resolve(pkg, { paths: [root, process.cwd(), __dirname] })); }
    catch {}
  }
  throw new Error("playwright not installed");
}

function waitReady(baseUrl, timeoutMs) {
  const mod = baseUrl.startsWith("https") ? require("https") : require("http");
  const deadline = Date.now() + timeoutMs;
  return new Promise((resolve, reject) => {
    const attempt = () => {
      const req = mod.request(baseUrl, { method: "HEAD", timeout: 3000 }, (res) => {
        res.resume();
        if (res.statusCode >= 200 && res.statusCode < 500) return resolve();
        retry();
      });
      req.on("error", retry);
      req.on("timeout", () => { req.destroy(); retry(); });
      req.end();
    };
    const retry = () => {
      if (Date.now() > deadline) return reject(new Error(`app did not become ready within ${timeoutMs}ms`));
      setTimeout(attempt, 500);
    };
    attempt();
  });
}

async function bootApp(startCmd, cwd, baseUrl, readyTimeoutMs) {
  if (!startCmd) return () => {};
  const proc = cp.spawn(startCmd, { cwd, shell: true, detached: true, stdio: "ignore" });
  try { await waitReady(baseUrl, readyTimeoutMs); }
  catch (e) { try { process.kill(-proc.pid); } catch {} throw e; }
  return () => { try { process.kill(-proc.pid); } catch {} };
}

function withTimeout(promise, ms) {
  let timer;
  const timeout = new Promise((_, reject) => {
    timer = setTimeout(() => reject(new Error(`journey timed out after ${ms}ms`)), ms);
  });
  return Promise.race([promise, timeout]).finally(() => clearTimeout(timer));
}

// Records one clip: launches a context with video capture, runs the journey under
// budgetMs, and closes the context regardless of outcome so the video always
// flushes. Shared by the after-run and the before cache-miss recording.
async function recordClip(browser, previewsRoot, runFn, vw, vh, ctx, budgetMs, storageStatePath) {
  const tmpDir = fs.mkdtempSync(path.join(previewsRoot, "tmp-"));
  try {
    const contextOpts = {
      viewport: { width: vw, height: vh },
      recordVideo: { dir: tmpDir, size: { width: vw, height: vh } },
    };
    if (storageStatePath) contextOpts.storageState = storageStatePath;
    const context = await browser.newContext(contextOpts);
    const page = await context.newPage();
    const video = page.video();
    let runErr = null;
    try { await withTimeout(runFn(page, ctx), budgetMs); }
    catch (e) { runErr = e; }
    // context.close() finalizes the video file; video.path() only resolves to a
    // real path once that happens (must record even when the journey timed out).
    await context.close();
    if (runErr) return { error: String((runErr && runErr.message) || runErr), recordedPath: null };
    return { error: null, recordedPath: await video.path() };
  } finally {
    fs.rmSync(tmpDir, { recursive: true, force: true });
  }
}

async function recordAfter(browser, previewsRoot, mod, slug, vw, vh, config, outDir, budgetMs) {
  const ctx = { baseUrl: config.baseUrl, viewport: vw, side: "after", slug, outDir };
  const { error, recordedPath } = await recordClip(browser, previewsRoot, mod.run, vw, vh, ctx, budgetMs, config.storageState);
  if (error) return { path: null, error };
  const destPath = path.join(outDir, `${slug}.${vw}.after.webm`);
  try { fs.renameSync(recordedPath, destPath); }
  catch (e) { return { path: null, error: `failed to save clip: ${e.message}` }; }
  return { path: destPath, error: null };
}

async function recordBefore(browser, root, previewsRoot, mod, slug, journeyHash, mergeBase, vw, vh, config, outDir, budgetMs) {
  if (mod.sinceMain) {
    try {
      fs.writeFileSync(
        path.join(outDir, `${slug}.${vw}.before-missing.txt`),
        "This screen did not exist on main — no before recording.\n",
      );
    } catch {}
    return { path: null, cached: false, missing: true, missingReason: "sinceMain" };
  }
  if (!mergeBase) return { path: null, cached: false, missing: true, missingReason: "no merge-base" };

  const baselineDir = path.join(previewsRoot, "baseline");
  fs.mkdirSync(baselineDir, { recursive: true });
  const baselinePath = path.join(baselineDir, `${mergeBase}.${journeyHash}.${vw}.webm`);
  if (fs.existsSync(baselinePath)) return { path: baselinePath, cached: true, missing: false };

  const wtDir = path.join(previewsRoot, `wt-${mergeBase}`);
  try {
    cp.execFileSync("git", ["worktree", "add", "--detach", wtDir, mergeBase], { cwd: root, stdio: "ignore" });
  } catch (e) {
    return { path: null, cached: false, missing: true, missingReason: `worktree add failed: ${e.message}` };
  }
  let teardown = () => {};
  try {
    teardown = await bootApp(config.startCmd, wtDir, config.baseUrl, config.readyTimeoutMs);
    // Always the journey file loaded from HEAD, never a worktree copy — the same
    // code drives both checkouts so the two clips differ only by app behavior.
    const ctx = { baseUrl: config.baseUrl, viewport: vw, side: "before", slug, outDir };
    const { error, recordedPath } = await recordClip(browser, previewsRoot, mod.run, vw, vh, ctx, budgetMs, config.storageState);
    if (error) return { path: null, cached: false, missing: true, missingReason: `before-run failed: ${error}` };
    fs.renameSync(recordedPath, baselinePath);
    return { path: baselinePath, cached: false, missing: false };
  } catch (e) {
    return { path: null, cached: false, missing: true, missingReason: `before-run failed: ${e.message}` };
  } finally {
    teardown();
    try { cp.execFileSync("git", ["worktree", "remove", "--force", wtDir], { cwd: root, stdio: "ignore" }); } catch {}
  }
}

function buildComposite(ffmpegPath, beforePath, afterPath, outPath, vw, vh) {
  const label = (text) => `drawtext=text='${text}':x=10:y=10:fontsize=28:fontcolor=white:box=1:boxcolor=black@0.5`;
  const filter =
    `[0:v]scale=${vw}:${vh},${label("before")}[b];` +
    `[1:v]scale=${vw}:${vh},${label("after")}[a];` +
    `[b][a]hstack=inputs=2[out]`;
  cp.execFileSync(ffmpegPath, [
    "-y", "-i", beforePath, "-i", afterPath,
    "-filter_complex", filter, "-map", "[out]",
    "-c:v", "libvpx", "-b:v", "1M", outPath,
  ], { stdio: ["ignore", "ignore", "pipe"], timeout: 120000 });
}

function downscaleClip(ffmpegPath, srcPath) {
  const dstPath = srcPath.replace(/\.webm$/, "") + ".small.webm";
  cp.execFileSync(ffmpegPath, [
    "-y", "-i", srcPath, "-vf", "scale=iw/2:-2",
    "-c:v", "libvpx", "-b:v", "500k", dstPath,
  ], { stdio: ["ignore", "ignore", "pipe"], timeout: 120000 });
  return dstPath;
}

function caption(title, vw, kind) {
  return `${title} — ${vw}px ${kind}`;
}

// Decision 3/5: composite when a full ffmpeg found both hstack and drawtext;
// otherwise the raw pair. Budget is enforced per attachment, one downscale retry,
// then drop-and-report — never fails the pass.
function buildAttachmentsForViewport(ffmpeg, outDir, slug, title, vw, before, after, budgetBytes) {
  const haveBoth = before && before.path && !before.missing && after && after.path;
  let composite = null;
  const candidates = [];

  if (ffmpeg && ffmpeg.tier === "full" && haveBoth) {
    const compositePath = path.join(outDir, `${slug}.${vw}.composite.webm`);
    composite = { path: compositePath, ok: false, error: null };
    try {
      buildComposite(ffmpeg.path, before.path, after.path, compositePath, vw, vw === 390 ? 844 : 900);
      composite.ok = true;
      candidates.push({ path: compositePath, caption: caption(title, vw, "before/after") });
    } catch (e) {
      composite.error = String((e && e.message) || e);
    }
  }
  if (candidates.length === 0) {
    if (before && before.path) candidates.push({ path: before.path, caption: caption(title, vw, "before") });
    if (after && after.path) candidates.push({ path: after.path, caption: caption(title, vw, "after") });
  }

  const attachments = [];
  const dropped = [];
  for (const c of candidates) {
    let bytes;
    try { bytes = fs.statSync(c.path).size; } catch { continue; }
    let finalPath = c.path;
    let downscaled = false;
    if (bytes > budgetBytes) {
      if (!ffmpeg) {
        dropped.push({ path: c.path, bytes, reason: "over budget; no ffmpeg available for downscale" });
        continue;
      }
      try {
        const dst = downscaleClip(ffmpeg.path, c.path);
        const dstBytes = fs.statSync(dst).size;
        if (dstBytes <= budgetBytes) { finalPath = dst; bytes = dstBytes; downscaled = true; }
        else { dropped.push({ path: dst, bytes: dstBytes, reason: `still over budget (${budgetBytes}B) after downscale` }); continue; }
      } catch (e) {
        dropped.push({ path: c.path, bytes, reason: `over budget; downscale failed: ${(e && e.message) || e}` });
        continue;
      }
    }
    attachments.push({ path: finalPath, caption: c.caption, bytes, downscaled });
  }
  return { composite, attachments, dropped };
}

async function attachResults(root, opts, attachments) {
  const ghVer = ghVersion();
  if (attachments.length === 0) return { mode: "local", ghVersion: ghVer, ok: true, error: null };

  const wantAttach = opts.attach !== false;
  const pr = wantAttach ? resolvePr(root, opts.pr) : null;
  const canGhAttach = wantAttach && pr && ghVer && semverGte(ghVer, "2.99.0") && ghAuthed();

  if (canGhAttach) {
    try {
      const args = ["pr", "comment", pr];
      for (const a of attachments) args.push("--attach", `${a.path}#${a.caption}`);
      args.push("--body", "Preview recordings attached below.");
      cp.execFileSync("gh", args, { cwd: root, stdio: ["ignore", "ignore", "pipe"] });
      return { mode: "gh", ghVersion: ghVer, ok: true, error: null };
    } catch (e) {
      const error = String((e && e.message) || e);
      console.log(`preview: gh attach failed: ${error}`);
      return { mode: "gh", ghVersion: ghVer, ok: false, error };
    }
  }

  const reason = !wantAttach ? "attach disabled (--no-attach)"
    : !ghVer ? "gh not found"
    : !semverGte(ghVer, "2.99.0") ? `gh ${ghVer} predates --attach (needs 2.99.0)`
    : !ghAuthed() ? "gh not authenticated"
    : "no PR resolvable";
  console.log(`preview: ${reason} — drag these into the PR body:`);
  for (const a of attachments) console.log(`  ${a.path}`);
  return { mode: "local", ghVersion: ghVer, ok: true, error: null };
}

async function runAll(root, journeyFiles, config, mergeBase, pw, opts) {
  const previewsRoot = path.join(root, ".claude-runs", "previews");
  fs.mkdirSync(previewsRoot, { recursive: true });
  const ffmpeg = findFfmpeg();
  const browser = await pw.chromium.launch();
  let teardownApp = () => {};
  const journeys = [];
  const lines = [];
  const allAttachments = [];
  try {
    if (config.startCmd) {
      try { teardownApp = await bootApp(config.startCmd, root, config.baseUrl, config.readyTimeoutMs); }
      catch (e) { lines.push(`preview: app failed to become ready: ${e.message}`); }
    }
    for (const file of journeyFiles) {
      const slug = path.basename(file, ".mjs");
      const outDir = path.join(previewsRoot, slug);
      clearDir(outDir);
      fs.mkdirSync(outDir, { recursive: true });

      const journeyHash = hashFile(file);
      const { mod, error: loadError } = await loadJourney(file);
      if (loadError || !mod || typeof mod.run !== "function") {
        const reason = loadError || "journey does not export run(page, ctx)";
        lines.push(`${slug}: SKIPPED (${reason})`);
        journeys.push({
          slug, title: (mod && mod.title) || slug, sinceMain: !!(mod && mod.sinceMain),
          journeyHash, mergeBase, ok: false, error: reason,
          budgetBytes: config.budgetBytes, userFacingPaths: config.userFacingPaths, viewports: [],
        });
        continue;
      }

      const title = mod.title || slug;
      const sinceMain = !!mod.sinceMain;
      const viewports = mod.viewports || config.viewports;
      const budgetMs = mod.budgetMs || 60000;
      const viewportResults = [];
      let journeyOk = true;

      for (const vw of viewports) {
        const vh = vw === 390 ? 844 : 900;
        const before = await recordBefore(browser, root, previewsRoot, mod, slug, journeyHash, mergeBase, vw, vh, config, outDir, budgetMs);
        const after = await recordAfter(browser, previewsRoot, mod, slug, vw, vh, config, outDir, budgetMs);
        if (after.error) journeyOk = false;
        const { composite, attachments, dropped } = buildAttachmentsForViewport(
          ffmpeg, outDir, slug, title, vw, before, after, config.budgetBytes,
        );
        allAttachments.push(...attachments);
        viewportResults.push({
          viewport: vw,
          before: { path: before.path, cached: before.cached, missing: before.missing, missingReason: before.missingReason || null },
          after: { path: after.path },
          error: after.error || null,
          composite, attachments, dropped,
        });
        const beforeState = before.missing ? `missing(${before.missingReason})` : before.cached ? "cached" : "recorded";
        lines.push(`${slug} @${vw}: before=${beforeState} after=${after.error ? `FAILED (${after.error})` : "recorded"}`);
        for (const d of dropped) lines.push(`${slug} @${vw}: DROPPED ${d.path} (${d.bytes}B) — ${d.reason}`);
      }

      journeys.push({
        slug, title, sinceMain, journeyHash, mergeBase, ok: journeyOk, error: null,
        budgetBytes: config.budgetBytes, userFacingPaths: config.userFacingPaths, viewports: viewportResults,
      });
    }
  } finally {
    teardownApp();
    try { await browser.close(); } catch {}
  }
  const attach = await attachResults(root, opts, allAttachments);
  return { generatedAt: new Date().toISOString(), journeys, lines, ffmpeg, attach };
}

function writeResult(root, result) {
  const { lines, ...persisted } = result;
  try {
    fs.writeFileSync(path.join(root, ".claude-runs", "previews", "result.json"), JSON.stringify(persisted, null, 2));
  } catch (e) { console.error(`preview: failed to write result.json: ${e.message}`); }
}

function pruneOldBaselines(root) {
  const dir = path.join(root, ".claude-runs", "previews", "baseline");
  let files;
  try { files = fs.readdirSync(dir); } catch { return; }
  const cutoff = Date.now() - 7 * 24 * 60 * 60 * 1000;
  for (const f of files) {
    const p = path.join(dir, f);
    try { if (fs.statSync(p).mtimeMs < cutoff) fs.unlinkSync(p); } catch {}
  }
}

function finalTally(result) {
  let recorded = 0, skipped = 0, failed = 0;
  for (const j of result.journeys) {
    if (j.viewports.length === 0) { skipped++; continue; }
    for (const v of j.viewports) (v.error ? failed++ : recorded++);
  }
  return `preview: ${recorded} recorded, ${skipped} skipped, ${failed} failed`;
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const H = loadHookLib();
  if (!H) { console.log("preview: skipped (phalanx-hook.js not found)"); return; }
  const root = H.repoRoot(process.cwd());
  ensureGitignore(root);

  const markerPath = path.join(root, ".phalanx-preview");
  if (!fs.existsSync(markerPath)) { console.log("preview: skipped (no .phalanx-preview marker)"); return; }

  let config;
  try { config = parseConfig(markerPath); }
  catch (e) { console.log(`preview: skipped (invalid .phalanx-preview: ${e.message})`); return; }

  const storageState = resolveStorageState(root, config);
  if (storageState && !storageState.exists) {
    console.log(`preview: WARNING storageState "${storageState.path}" not found or unreadable — recording SIGNED-OUT`);
  }
  config.storageState = storageState && storageState.exists ? storageState.path : null;

  const mergeBase = getMergeBase(root);
  const userFacing = computeUserFacing(root, mergeBase, config.userFacingPaths);
  if (userFacing.gated && !opts.force) {
    if (opts.dryRun) console.log(JSON.stringify({ dryRun: true, mergeBase, userFacing, storageState }, null, 2));
    else console.log("preview: skipped (no user-facing paths changed)");
    return;
  }

  const previewsDir = path.join(root, ".phalanx", "previews");
  const journeyFiles = resolveJourneyFiles(root, previewsDir, opts);
  if (journeyFiles.length === 0) { console.log("preview: skipped (no journeys)"); return; }

  if (opts.dryRun) {
    const plan = await buildDryRunPlan(root, journeyFiles, config, mergeBase);
    console.log(JSON.stringify({ ...plan, userFacing, storageState }, null, 2));
    return;
  }

  let pw;
  try { pw = resolvePlaywright(root); }
  catch { console.log("preview: skipped (playwright not installed)"); return; }

  const result = await runAll(root, journeyFiles, config, mergeBase, pw, opts);
  result.userFacing = userFacing;
  writeResult(root, result);
  pruneOldBaselines(root);

  if (opts.json) {
    console.log(JSON.stringify({
      generatedAt: result.generatedAt, ffmpeg: result.ffmpeg, attach: result.attach,
      journeys: result.journeys, userFacing: result.userFacing,
    }));
  } else { for (const line of result.lines) console.log(line); console.log(finalTally(result)); }
}

function safeExit(e) {
  try { console.error(`preview: unexpected error: ${(e && e.stack) || e}`); } catch {}
  process.exit(0);
}
process.on("unhandledRejection", safeExit);
process.on("uncaughtException", safeExit);

(async () => {
  try { await main(); }
  catch (e) { safeExit(e); return; }
  process.exit(0);
})();
